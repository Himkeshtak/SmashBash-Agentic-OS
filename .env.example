# Copy to .env. Add your own OpenRouter key locally; never commit it.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=openrouter/free
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_ONLY=true
LLM_RESPONSE_FORMAT=json_object
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096

# Local alternative: Ollama running on this PC (no API key required).
# LLM_PROVIDER=ollama
# LLM_MODEL=your-installed-model
# LLM_BASE_URL=http://127.0.0.1:11434/v1

# Trusted runtime configuration. The LLM cannot override these values.
SMASHBASH_IMAGE=data/device.img
SMASHBASH_POLICY=config/policy.example.json
SMASHBASH_STATE_DIR=.smashbash
SMASHBASH_KERNEL=xv6/kernel/kernel
SMASHBASH_QEMU=qemu-system-riscv64
SMASHBASH_PRINCIPAL=local-user
